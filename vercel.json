{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci --prefix frontend",
  "buildCommand": "npm run build --prefix frontend",
  "outputDirectory": "frontend/dist/tictactoe-web/browser",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://tictactoe-abb-api.onrender.com/api/:path*"
    },
    {
      "source": "/swagger",
      "destination": "https://tictactoe-abb-api.onrender.com/swagger"
    },
    {
      "source": "/swagger/:path*",
      "destination": "https://tictactoe-abb-api.onrender.com/swagger/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
