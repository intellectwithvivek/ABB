<!-- Shared MSBuild settings applied to every project under backend/. -->
<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Keeps the build at zero warnings: any new warning fails the build instead of piling up. -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Except NuGet's vulnerability audit (NU1901-NU1904): a newly published advisory stays a visible warning for
         Dependabot to fix, instead of failing CI or the deployment of an unrelated change. -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>
</Project>
