{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Swagger": {
    "Enabled": true
  },
  "RateLimiting": {
    "PermitLimit": 300,
    "CreateGamePermitLimit": 30,
    "WindowSeconds": 60
  },
  "Sessions": {
    "IdleTimeout": "02:00:00",
    "CleanupInterval": "00:10:00"
  }
}
