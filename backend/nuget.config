<?xml version="1.0" encoding="utf-8"?>
<!-- Repo-local package source so `dotnet restore` works even when a machine has no global NuGet source configured. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
